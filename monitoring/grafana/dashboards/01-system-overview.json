      "targets": [
        { "expr": "rate(upi_transactions_attempted_total[1m])", "legendFormat": "Attempts/s", "refId": "A" },
        { "expr": "rate(upi_transactions_settled_total[1m])", "legendFormat": "Settled/s", "refId": "B" },
        { "expr": "rate(upi_transactions_duplicate_total[1m])", "legendFormat": "Duplicates/s", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Settlement Latency (p50, p90, p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(upi_settlement_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, sum(rate(upi_settlement_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(upi_settlement_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
